# Production Environment Configuration
# IMPORTANT: Copy this file to .env.production and fill with secure values
# NEVER commit .env.production to git!

# Application
APP_NAME=HertzBoard
APP_ENV=production
APP_PORT=8080
APP_DEBUG=false

# Database - CHANGE THESE PASSWORDS!
DB_HOST=postgres
DB_PORT=5432
DB_NAME=hertzboard
DB_USER=hertzboard
DB_PASSWORD=s6AdynFXzUfPk49VEtbEUZ/4VNZ9fAMDi+C8L2cZDNM=
DB_SSL_MODE=require
DB_MAX_CONNECTIONS=100
DB_MAX_IDLE_CONNECTIONS=10
DB_CONNECTION_MAX_LIFETIME=3600

# Redis - CHANGE THIS PASSWORD!
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=Of8L4I415ow9t8hvFKQbKDVgTCGdQZ9b0yN8hVmddfY=
REDIS_DB=0

# MinIO - CHANGE THESE CREDENTIALS!
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=hertzboard-production
MINIO_SECRET_KEY=xfdi+mKW++5uIaQ2jGXs6dg1ER0xFo28lEMo5WFAERQ=
MINIO_USE_SSL=false
MINIO_BUCKET_ASSETS=hertzboard-assets
MINIO_BUCKET_EXPORTS=hertzboard-exports
