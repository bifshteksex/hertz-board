# ClickHouse - CHANGE THIS PASSWORD!
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_DATABASE=hertzboard_analytics
CLICKHOUSE_USER=hertzboard
CLICKHOUSE_PASSWORD=w1s4BiWaCUQnkN/jztOy/6ro5DQBHXKlcax7x9/IPyU=

# NATS
NATS_URL=nats://nats:4222

# JWT - CHANGE THIS SECRET! Use: openssl rand -base64 64
JWT_SECRET=H6Xl7O/TN0WWHVoafkB5mJd4SHBavVPkZC03c71akBqDxmx5peJRsYT124X5bP49D+OGfnlHZ0366v9WlQo+lA==
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY=7d

# OAuth - Configure with your OAuth provider credentials
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URL=https://hertz.rshang.in/api/v1/auth/google/callback

GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_REDIRECT_URL=https://hertz.rshang.in/api/v1/auth/github/callback

# Email - Configure with your SMTP provider
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your-sendgrid-api-key
SMTP_FROM=noreply@hertz.rshang.in

# CORS - Set your production domain
CORS_ALLOWED_ORIGINS=https://hertz.rshang.in,https://www.hertz.rshang.in
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS,PATCH
CORS_ALLOWED_HEADERS=Content-Type,Authorization

# WebSocket
WS_READ_BUFFER_SIZE=1024
WS_WRITE_BUFFER_SIZE=1024
WS_MAX_MESSAGE_SIZE=10485760

# File Upload
MAX_UPLOAD_SIZE=10485760
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,image/webp,image/svg+xml

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_DURATION=1m

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
LOG_OUTPUT=stdout

# Monitoring
METRICS_ENABLED=true
METRICS_PORT=9090
TRACING_ENABLED=true
JAEGER_ENDPOINT=http://jaeger:14268/api/traces

# Security Headers
SECURITY_HSTS_ENABLED=true
SECURITY_CSP_ENABLED=true
SECURITY_FRAME_OPTIONS=DENY
SECURITY_CONTENT_TYPE_NOSNIFF=true
SECURITY_XSS_PROTECTION=true
